NODE_ENV=development
PORT=5002

# ─── MongoDB Atlas (DB riêng cho product service) ─────────────────────
# Tạo database user riêng với quyền readWrite trên bookstore_products
MONGO_URI=mongodb+srv://<product_user>:<password>@cluster0.xxxxx.mongodb.net/bookstore_products

# Frontend origin (cho CORS)
CLIENT_URL=http://localhost:5173

# ─── Auth Service ─────────────────────────────────────────────────────
# product-service gọi GET {AUTH_SERVICE_URL}/api/v1/auth/validate để xác thực token
# Local dev  : http://localhost:5003
# Docker     : http://auth-service:8080
# Production : https://auth-service-xxxx-as.a.run.app  (Cloud Run URL)
AUTH_SERVICE_URL=http://localhost:5003

# ─── Meilisearch (GCP VM e2-micro) ────────────────────────────────────
# Local dev: chạy docker (xem README)
# Production: http://<GCP_VM_EXTERNAL_IP>:7700
#             hoặc https://meili.yourdomain.com nếu đã setup HTTPS
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=dev_master_key_change_me_in_prod
MEILI_INDEX=books

# ─── Redis Upstash ────────────────────────────────────────────────────
# Format: rediss://default:<password>@<region>.upstash.io:6379
# Để trống = không dùng cache (fallback về MongoDB cho mọi query)
# Free tier: https://console.upstash.com
REDIS_URL=rediss://default:<password>@<region>.upstash.io:6379

# ─── Internal Auth ────────────────────────────────────────────────────
# Key nội bộ để backend monolith (cart/order) gọi stock API
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PHẢI GIỐNG với PRODUCT_INTERNAL_SECRET trong backend/.env
PRODUCT_INTERNAL_SECRET=doi_internal_secret_nay

# ─── Migration (chỉ dùng khi chạy scripts/migrate-from-monolith.js) ──
# MONOLITH_MONGO_URI=mongodb+srv://...@cluster0.../bookstore
