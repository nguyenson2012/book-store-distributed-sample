NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.6o6vo5n.mongodb.net/bookstore?appName=Cluster0
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=doi_chuoi_bi_mat_nay_1
JWT_REFRESH_SECRET=doi_chuoi_bi_mat_nay_2
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email — để trống để dùng Ethereal (test) trong dev
# Điền vào để dùng Gmail/SendGrid thật trong production
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@bookstore.dev

# ─── Product Service ──────────────────────────────────────────────────
# Local dev  : http://localhost:5002
# Production : https://product-service-xxxx-as.a.run.app  (Cloud Run URL)
# Để trống   : monolith tự dùng MongoDB local cho books (không cần product-service)
PRODUCT_SERVICE_URL=http://localhost:5002

# PHẢI GIỐNG với PRODUCT_INTERNAL_SECRET trong product-service/.env
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRODUCT_INTERNAL_SECRET=doi_internal_secret_nay