NODE_ENV=development
PORT=5003
# DB RIÊNG cho auth-service (khác DB monolith)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/bookstore_auth?appName=Cluster0

# Chỉ dùng khi chạy `npm run migrate` (copy users từ DB monolith sang DB trên)
# MONOLITH_MONGO_URI=mongodb+srv://...@cluster0.xxxxx.mongodb.net/bookstore
CLIENT_URL=http://localhost:5173

# PHẢI GIỐNG với JWT_ACCESS_SECRET của monolith/product-service để token verify được
JWT_ACCESS_SECRET=doi_chuoi_bi_mat_nay_1
JWT_REFRESH_SECRET=doi_chuoi_bi_mat_nay_2
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email — để trống để dùng Ethereal (test) trong dev
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@bookstore.dev

# Key nội bộ để monolith gọi /internal/v1 (PHẢI GIỐNG AUTH_INTERNAL_SECRET trong backend/.env)
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_INTERNAL_SECRET=doi_auth_internal_secret_nay
